# Pollen stack for the Microduck sim; arteeh sensor forks until upstreamed. Gitlinks pin the
# exact commits; drivers/microduck/setup-sim.sh reads them from here.
# microduck: fork based on daemon-v0.17.3; microduck_rl: fork based on develop.
# Both add head sensors to the sim. gst-plugins-rs: upstream 0.14.5 or newer.
[submodule "third_party/microduck"]
	path = third_party/microduck
	url = https://github.com/arteeh/microduck
	shallow = true
[submodule "third_party/microduck_rl"]
	path = third_party/microduck_rl
	url = https://github.com/arteeh/microduck_rl
	shallow = true
[submodule "third_party/gst-plugins-rs"]
	path = third_party/gst-plugins-rs
	url = https://gitlab.freedesktop.org/gstreamer/gst-plugins-rs
	shallow = true
