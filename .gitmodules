# The Pollen stack for the virtual Microduck. The gitlinks pin the exact commits; compose.yaml
# builds the robot side from them, drivers/microduck/sim.py runs the body from microduck_rl.
# microduck: release tag daemon-v0.18.3 plus the beta board's simulated head IMU,
# ToF, calibrated camera and home-relative gaze commands (API v48), frames that carry
# their capture time in their RTP timestamps, a simulated head IMU clocked by its
# quickest handshake (feat/frame-stamps-0.18.3) and up to four ToF targets per zone
# (API v49; arteeh fork, branch feat/tof-targets-0.18.3).
# microduck_rl: its develop branch (no releases; bae39f5) plus the matching simulated
# sensors and per-board camera mount (feat/beta-sim-develop) and a simulated ToF whose
# zones see their cone (arteeh fork, branch feat/tof-honest-develop).
# gst-plugins-rs: 0.14.5+.
[submodule "third_party/microduck"]
	path = third_party/microduck
	url = https://github.com/arteeh/microduck
	shallow = true
[submodule "third_party/microduck_rl"]
	path = third_party/microduck_rl
	url = https://github.com/arteeh/microduck_rl
	shallow = true
[submodule "third_party/gst-plugins-rs"]
	path = third_party/gst-plugins-rs
	url = https://gitlab.freedesktop.org/gstreamer/gst-plugins-rs
	shallow = true
