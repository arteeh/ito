# The Pollen stack for the Microduck sim. The gitlinks pin the exact commits;
# drivers/microduck/setup-sim.sh reads them from here.
# microduck: release tag daemon-v0.17.4 plus the beta board's simulated head IMU,
# ToF, calibrated camera and home-relative gaze commands (arteeh fork,
# branch fix/head-still-shake).
# microduck_rl: its develop branch (no releases) plus the matching simulated sensors
# and per-board camera mount (arteeh fork, same branch name). gst-plugins-rs: 0.14.5+.
[submodule "third_party/microduck"]
	path = third_party/microduck
	url = https://github.com/arteeh/microduck
	shallow = true
[submodule "third_party/microduck_rl"]
	path = third_party/microduck_rl
	url = https://github.com/arteeh/microduck_rl
	shallow = true
[submodule "third_party/gst-plugins-rs"]
	path = third_party/gst-plugins-rs
	url = https://gitlab.freedesktop.org/gstreamer/gst-plugins-rs
	shallow = true
