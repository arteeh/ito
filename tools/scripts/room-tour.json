[
  {"for": 20, "note": "connect and settle; nobody touches anything"},
  {"for": 2, "do": "resume", "note": "resume"},
  {"for": 12, "note": "stand still, hands off: the head must not move on its own"},
  {"for": 4, "keys": "w", "note": "walk forward"},
  {"for": 6, "note": "stop and hold"},
  {"for": 2, "turn": -40, "note": "look left 80 degrees"},
  {"for": 8, "note": "hold the look left: head must stay there"},
  {"for": 4, "turn": 40, "note": "look right 160 degrees"},
  {"for": 8, "note": "hold the look right"},
  {"for": 2, "turn": -40, "note": "back to straight ahead"},
  {"for": 1.5, "tilt": 20, "note": "look up 30 degrees"},
  {"for": 4, "note": "hold up"},
  {"for": 3, "tilt": -20, "note": "look down 60 degrees"},
  {"for": 4, "note": "hold down"},
  {"for": 1.5, "tilt": 20, "note": "level again"},
  {"for": 5, "keys": "d", "note": "turn the body right"},
  {"for": 4, "note": "hold"},
  {"for": 6, "keys": "w", "turn": -15, "note": "walk forward while looking left"},
  {"for": 3, "keys": "s", "note": "walk back"},
  {"for": 5, "keys": "a", "note": "turn the body left"},
  {"for": 5, "keys": "w", "note": "walk forward"},
  {"for": 15, "note": "stand still, hands off again"},
  {"for": 2, "do": "stop", "note": "stop the robot"},
  {"for": 12, "note": "stopped: head must stay put"},
  {"for": 2, "do": "recenter", "note": "recenter view on the robot"},
  {"for": 3, "note": "end"}
]
