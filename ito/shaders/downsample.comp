#version 460
// One mipmap level of the fill's depth map from the one above: the mean of its 2x2 texels.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rg32f) uniform readonly image2D above;
layout(set = 0, binding = 1, rg32f) uniform writeonly image2D below;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(below)))) return;
    ivec2 last = imageSize(above) - 1;
    vec4 sum = vec4(0.0);
    for (int j = 0; j < 2; ++j)
        for (int i = 0; i < 2; ++i) sum += imageLoad(above, min(p * 2 + ivec2(i, j), last));
    imageStore(below, p, sum * 0.25);
}
