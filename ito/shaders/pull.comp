#version 460
// Pull: each level's holes (weight < 1) filled from the coarser, already filled level.
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant) uniform Pull { ivec2 size; };
layout(set = 0, binding = 0) uniform sampler2D pushed;
layout(set = 0, binding = 1) uniform sampler2D coarse;
layout(set = 0, binding = 2, rg32f) uniform writeonly image2D result;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size))) return;
    vec2 own = texelFetch(pushed, p, 0).rg;
    vec2 c = textureLod(coarse, (vec2(p) + 0.5) / vec2(size), 0.0).rg;
    imageStore(result, p, vec4(own.x * own.y + c.x * (1.0 - own.y), max(own.y, c.y), 0, 0));
}
