#version 460
// The robot camera's frame to RGB at its described pinhole (render/camera.py): Y'CbCr as it was
// decoded (NV12, or planar), through the lens it came through.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform Straighten {
    mat4 to_rgb;        // a mat3 in its columns
    vec4 offset;
    vec4 pinhole;       // fx fy cx cy that the frame is straightened to
    vec4 lens;          // fx fy cx cy of the lens the frame came through
    vec4 lens_k[3];     // OpenCV's k1 k2 p1 p2, k3 k4 k5 k6, s1 s2 s3 s4
    vec2 size;          // the frame, pixels
    vec2 luma_scale;    // frame width / texture width (a decoder's padded lines)
    vec2 chroma_scale;
    vec2 stride;        // output pixel i is straightened pixel i * stride.x + stride.y
    int planar;
    int distorted;
};
layout(set = 0, binding = 1) uniform sampler2D luma;
layout(set = 0, binding = 2) uniform sampler2D chroma;  // CbCr (NV12), or Cb with chroma_v Cr
layout(set = 0, binding = 3) uniform sampler2D chroma_v;
layout(set = 0, binding = 4, rgba8) uniform writeonly image2D result;
#define k(n) lens_k[(n) / 4][(n) % 4]
void main() {
    ivec2 i = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(i, imageSize(result)))) return;
    // Pixel centres are whole numbers in OpenCV's camera model, and output row 0 is the
    // frame's top row.
    vec2 p = vec2(i) * stride.x + stride.y;
    vec2 source = p;
    if (distorted == 1) {
        vec2 xy = (p - pinhole.zw) / pinhole.xy;
        float r2 = dot(xy, xy), r4 = r2 * r2, r6 = r4 * r2;
        float radial = (1 + k(0) * r2 + k(1) * r4 + k(4) * r6)
                     / (1 + k(5) * r2 + k(6) * r4 + k(7) * r6);
        vec2 d = xy * radial + vec2(
            2 * k(2) * xy.x * xy.y + k(3) * (r2 + 2 * xy.x * xy.x) + k(8) * r2 + k(9) * r4,
            k(2) * (r2 + 2 * xy.y * xy.y) + 2 * k(3) * xy.x * xy.y + k(10) * r2 + k(11) * r4);
        source = d * lens.xy + lens.zw;
    }
    vec2 uv = (source + 0.5) / size;
    vec2 c = planar == 1
        ? vec2(textureLod(chroma, uv * chroma_scale, 0.0).r, textureLod(chroma_v, uv * chroma_scale, 0.0).r)
        : textureLod(chroma, uv * chroma_scale, 0.0).rg;
    vec3 ycc = vec3(textureLod(luma, uv * luma_scale, 0.0).r, c);
    imageStore(result, i, vec4(clamp(mat3(to_rgb) * (ycc - offset.xyz), 0.0, 1.0), 1));
}
